{
  "name": "zerocorps",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify-site.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit:report",
    "audit:report": "node scripts/audit-report.mjs",
    "env:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/env-check.mjs",
    "env:secrets": "node scripts/env-secrets.mjs",
    "env:app-url": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/env-app-url.mjs",
    "env:handoff": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/env-handoff.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-check.mjs",
    "db:backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-backup.mjs",
    "db:restore:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-restore-check.mjs",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-migrate.mjs",
    "db:check-role": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-check-role.mjs",
    "db:counts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-counts.mjs",
    "db:cleanup-test-accounts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-cleanup-test-accounts.mjs",
    "sessions:revoke-all": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sessions-revoke-all.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.7.5",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}

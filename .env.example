# ZeroCorps environment variables
#
# Copy this file to `.env.local` for development and fill in what the current
# milestone needs. Never commit a real `.env*` file; only this example is tracked.
#
# Every key is validated at startup by `src/env.ts`. A key becomes required in
# the milestone that first uses it, so blank values for later milestones are fine.

# ── Milestone 1: app ─────────────────────────────────────────────────────────
# Public origin of the site, no trailing slash. Required in production.
# Also used as the auth base URL from milestone 2, so there is one source of truth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Milestone 2: database, auth, email ───────────────────────────────────────
# Runtime connection. Supabase TRANSACTION pooler (port 6543). The app connects
# with prepared statements disabled, which this pooler mode requires.
DATABASE_URL=
# Migrations only (drizzle-kit). Supabase SESSION pooler (port 5432).
DATABASE_URL_MIGRATIONS=
# Signs sessions and cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Resend API key. When blank in development, emails are logged to the console.
RESEND_API_KEY=
# The From header for transactional email, on a domain verified with Resend.
EMAIL_FROM="ZeroCorps <no-reply@zerocorps.org>"

# ── Milestone 3: avatar storage (any S3-compatible API) ──────────────────────
# Supabase Storage now, MinIO later. Path-style addressing is used for both.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public base URL that object keys are appended to when rendering avatars.
STORAGE_PUBLIC_BASE_URL=

# ── Milestone 5: SMS verification ────────────────────────────────────────────
# `console` logs codes to the terminal (development). `twilio-verify` sends them.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Verify Service with "custom verification code" enabled.
TWILIO_VERIFY_SERVICE_SID=

# ── Milestone 6: Discord account linking (OAuth2, scope: identify) ───────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Milestone 8: rank role sync and the internal API for Agent Zero ──────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# JSON object mapping academy rank keys to Discord role IDs,
# for example {"recruit":"123456789012345678"}
DISCORD_RANK_ROLE_IDS=
# Shared secret Agent Zero sends in the X-Internal-Secret header.
# Generate with: openssl rand -base64 48
INTERNAL_API_SECRET=
# Secret for the role-sync retry endpoint called by a cron job.
CRON_SECRET=

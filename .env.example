# ZeroCorps environment variables
#
# Copy this file to `.env.local` for development and fill in what the current
# milestone needs. Never commit a real `.env*` file; only this example is tracked.
#
# Every key is validated at startup by `src/env-schema.ts`. A key becomes required in
# the milestone that first uses it, so blank values for later milestones are fine.
#
#   npm run env:check     says which keys are filled, blank or malformed (names only)
#   npm run env:secrets   fills in the blank secrets below with fresh random values
#
# ONE database is shared by the laptop and the live site. Treat this file as
# production. See docs/SECURITY.md, "One shared database".

# ── Milestone 1: app ─────────────────────────────────────────────────────────
# Public origin of the site, no trailing slash. It is also the auth base URL and the
# only trusted origin. On the laptop: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Milestone 2: environment and sign-up mode ────────────────────────────────
# `local` on the laptop, `production` on the live site. Required for a production
# build. `production` refuses a non-https URL and a non-empty EMAIL_ALLOWLIST.
APP_ENV=local
# closed | allowlist | open. Enforced on the server. Defaults to closed.
SIGNUP_MODE=closed
# Comma-separated addresses that may sign up while SIGNUP_MODE=allowlist.
SIGNUP_ALLOWLIST=

# ── Milestone 2: database ────────────────────────────────────────────────────
# What the app uses. Supabase TRANSACTION pooler (port 6543), as the role
# `zerocorps_app`, which has no rights to create, alter or drop anything:
#   postgresql://zerocorps_app.<project-ref>:<password>@<pooler-host>:6543/postgres
# Use a password of letters and numbers only. Characters such as / ? # @ : % $
# break the URL.
DATABASE_URL=
# Migrations and backups only, and only ever on the laptop. Supabase SESSION pooler
# (port 5432), as the owner role `postgres.<project-ref>`. Never set this in Vercel.
DATABASE_URL_MIGRATIONS=
# Where `npm run db:backup` writes encrypted backups. Defaults to ./backups, which
# is gitignored. A folder outside the repository is better.
BACKUP_DIR=

# ── Milestone 2: secrets ─────────────────────────────────────────────────────
# At least 32 characters each, all different, and different again on the live site.
# `npm run env:secrets` fills in the blank ones.
# Signs sessions and cookies.
BETTER_AUTH_SECRET=
# Keys the hashes of sign-up codes, rate-limit identifiers and event-log entries.
HMAC_SECRET=
# The daily cleanup route accepts `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ── Milestone 2: email ───────────────────────────────────────────────────────
# Resend API key. Blank on the laptop: emails go to the console and a local outbox.
# If set on the laptop, mail is really sent, but only to EMAIL_ALLOWLIST.
RESEND_API_KEY=
# The From header for transactional email, on a domain verified with Resend.
EMAIL_FROM="ZeroCorps <no-reply@zerocorps.org>"
# Laptop only: the owner's own addresses. They are the only ones that receive real
# mail from the laptop, and `npm run db:cleanup-test-accounts` deletes the accounts
# that use them. Must be empty in production.
EMAIL_ALLOWLIST=

# ── Milestone 2: abuse limits, contacts, links ───────────────────────────────
# The request header that carries the client IP. It must be one your host sets
# itself and a visitor cannot forge. Defaults to x-forwarded-for.
TRUSTED_IP_HEADER=
# Published in /.well-known/security.txt. https:// or mailto:. Required in production.
SECURITY_CONTACT=
# Shown on /privacy and /terms. https:// or mailto:. Required in production.
PRIVACY_CONTACT=
# The Discord invite shown while sign-ups are closed. Optional.
DISCORD_INVITE_URL=

# ── Milestone 3: avatar storage (any S3-compatible API) ──────────────────────
# Supabase Storage now, MinIO later. Path-style addressing is used for both.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public base URL that object keys are appended to when rendering avatars.
STORAGE_PUBLIC_BASE_URL=

# ── Milestone 5: SMS verification ────────────────────────────────────────────
# `console` logs codes to the terminal (development). `twilio-verify` sends them.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Verify Service with "custom verification code" enabled.
TWILIO_VERIFY_SERVICE_SID=

# ── Milestone 6: Discord account linking (OAuth2, scope: identify) ───────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Milestone 8: rank role sync and the internal API for Agent Zero ──────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# JSON object mapping academy rank keys to Discord role IDs,
# for example {"recruit":"123456789012345678"}
DISCORD_RANK_ROLE_IDS=
# Shared secret Agent Zero sends in the X-Internal-Secret header.
INTERNAL_API_SECRET=

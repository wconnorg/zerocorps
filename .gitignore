.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Obsidian vault state (lessons are written in Obsidian; its workspace files are local)
.obsidian/

# local-only Claude Code settings
.claude/settings.local.json
